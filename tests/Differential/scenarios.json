    {
      "id": "sandbox_fstring_eval",
      "group": "sandbox-checker",
      "kind": "bool",
      "input": { "code": "f\"{eval('6*7')}\"" }
    },
    {
      "id": "sandbox_fstring_os_system",
      "group": "sandbox-checker",
      "kind": "bool",
      "input": { "code": "print(f\"{__import__('os').system('id')}\")" }
